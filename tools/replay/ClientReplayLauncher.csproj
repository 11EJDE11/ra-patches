<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ReplayLauncher</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <ClientBinaryPath Condition="'$(ClientBinaryPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\cncnet-ra-client-package\package\Resources\Binaries</ClientBinaryPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ClientReplayLauncher.cs" />
    <Compile Include="RAReplayArchive.cs" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Memory">
      <HintPath>$(ClientBinaryPath)\System.Memory.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckClientDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ClientBinaryPath)\System.Memory.dll')" Text="Set ClientBinaryPath to the replay-enabled client's Resources/Binaries directory (containing System.Memory.dll)." />
  </Target>
</Project>
