<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ClientIntegrationChecks</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ClientResourcesPath Condition="'$(ClientResourcesPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\cncnet-ra-client-package\package\Resources</ClientResourcesPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ClientIntegrationChecks.cs" />
    <Compile Include="RAReplayArchive.cs" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="clientdx"><HintPath>$(ClientResourcesPath)\clientdx.exe</HintPath><Private>false</Private></Reference>
    <Reference Include="ClientCore"><HintPath>$(ClientResourcesPath)\Binaries\Windows\ClientCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rampastring.Tools"><HintPath>$(ClientResourcesPath)\Binaries\Rampastring.Tools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Memory"><HintPath>$(ClientResourcesPath)\Binaries\System.Memory.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
